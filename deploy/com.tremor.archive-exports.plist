<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly unattended export archive (scripts/archive_weekly.sh): Sunday 10:00 local time; if the Mac is
  asleep or off then, launchd runs it once at the next wake. Never deletes anything.
  Template: __HOME__ is replaced at install time (deploy/DEPLOY_EXPORT_ARCHIVE.md, section 6).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tremor.archive-exports</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/tremor-merge/scripts/archive_weekly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/tremor-exports/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/tremor-exports/logs/launchd.log</string>
</dict>
</plist>
