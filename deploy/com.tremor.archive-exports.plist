<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OPTIONAL, NOT INSTALLED (2026-10-18): the weekly routine is run by hand from Terminal instead.
  Under launchd, macOS blocks network-volume access for /bin/bash (DEPLOY_EXPORT_ARCHIVE.md, 6b);
  it would need a dedicated app holding that permission. Kept for reference: Sunday 10:00 local time,
  once at the next wake if asleep; never deletes anything; __HOME__ is replaced at install time.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tremor.archive-exports</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/tremor-merge/scripts/archive_weekly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/tremor-exports/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/tremor-exports/logs/launchd.log</string>
</dict>
</plist>
